{
  "id": "dev.mufeed.Wordbook.Devel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "master",
  "sdk": "org.gnome.Sdk",
  "command": "wordbook",
  "finish-args": [
    "--socket=pulseaudio",
    "--share=ipc",
    "--device=dri",
    "--socket=fallback-x11",
    "--socket=wayland"
  ],
  "cleanup": ["*.a", "*.la", "/lib/pkgconfig", "/include", "/share/doc", "/share/man"],
  "modules": [
    {
      "name": "pcaudiolib",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/espeak-ng/pcaudiolib.git",
          "tag": "1.3",
          "commit": "e907571bad7dee296fb56a409a0f7c5a0c57d38a"
        }
      ]
    },
    {
      "name": "espeak-ng",
      "no-parallel-make": true,
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/espeak-ng/espeak-ng.git",
          "tag": "1.52.0",
          "commit": "4870adfa25b1a32b4361592f1be8a40337c58d6c"
        }
      ]
    },
    {
      "name": "ruby",
      "buildsystem": "simple",
      "build-commands": [
        "./configure --prefix=/app --disable-install-doc",
        "make -j${FLATPAK_BUILDER_N_JOBS:-4}",
        "make install"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/ruby/ruby.git",
          "tag": "v3_4_9"
        }
      ]
    },
    {
      "name": "wordbook-gems",
      "buildsystem": "simple",
      "build-options": {
        "build-args": ["--share=network"]
      },
      "build-commands": [
        "gem install bundler --no-document",
        "bundle install --gemfile=Gemfile --without development test documentation changelog style"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../.",
          "dest": "."
        }
      ]
    },
    {
      "name": "wordnet-data",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p data",
        "ruby -Ilib exe/wordbook-generate-db --source-file english-wordnet-2025-plus.xml.gz --output data/wn-dev.db.zst",
        "install -Dm644 data/wn-dev.db.zst /app/share/wordbook/wn-dev.db.zst"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../.",
          "dest": "."
        },
        {
          "type": "file",
          "url": "https://github.com/globalwordnet/english-wordnet/releases/download/2025-edition/english-wordnet-2025-plus.xml.gz",
          "sha256": "31f4af16c54b532fd5484d4cc33aee588a31bb5b70683ae8197842fde5b586bc"
        }
      ]
    },
    {
      "name": "wordbook",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "WORDBOOK_PROFILE": "development"
        }
      },
      "build-commands": [
        "install -Dm755 exe/wordbook /app/bin/wordbook",
        "install -Dm755 exe/wordbook-search-provider /app/bin/wordbook-search-provider",
        "install -Dm755 exe/wordbook-generate-db /app/bin/wordbook-generate-db",
        "rake install:data PREFIX=/app",
        "install -Dm644 data/icons/dev.mufeed.Wordbook-symbolic.svg /app/share/icons/hicolor/symbolic/apps/dev.mufeed.Wordbook-symbolic.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../.",
          "dest": "."
        }
      ]
    }
  ]
}
