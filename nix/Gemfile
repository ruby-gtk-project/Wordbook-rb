# frozen_string_literal: true

# The app's RUNTIME gems, for bundlerEnv in flake.nix. Generated by
# converge-port-gem.sh from the gemspec; do not edit by hand.
#
# The Gemfile at the repo root is kettle-jem's development bundle —
# rubocop, rspec, yard and the kettle-dev stack — and must not end up in
# a packaged app's closure.
source "https://rubygems.org"

gem "adwaita"
gem "gettext"
gem "gtk4"

# sqlite3 is a runtime dependency of the app (lib/wordbook/base.rb:3) and it is
# missing from this bundle, so the app built by flake.nix cannot read the
# WordNet database: every search lands on "Database not found". Adding it needs
# gemset.nix regenerated by bundix, which needs network access I did not have,
# and a Gemfile naming a gem the gemset does not hold fails the build outright.
# FINDINGS.md, defect 6.

# The port's own spec suite, used by the devShell only: `groups` in flake.nix
# keeps this out of the packaged app's runtime closure.
group :test do
  gem "rspec"
end
